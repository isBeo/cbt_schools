generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model ParentStudent {
  id           Int      @id @default(autoincrement())
  parentId     Int
  studentId    Int
  relationship String?
  createdAt    DateTime @default(now())
  parent       User     @relation("ParentChildren", fields: [parentId], references: [id])
  student      Student  @relation("StudentParents", fields: [studentId], references: [id])

  @@unique([parentId, studentId])
}

model TeacherAssignment {
  id        Int      @id @default(autoincrement())
  teacherId Int
  classId   Int
  subjectId Int
  createdAt DateTime @default(now())
  class     Class    @relation(fields: [classId], references: [id])
  subject   Subject  @relation(fields: [subjectId], references: [id])
  teacher   User     @relation(fields: [teacherId], references: [id])

  @@unique([teacherId, classId, subjectId])
  @@index([teacherId])
  @@index([classId, subjectId])
}

model School {
  id                 Int                 @id @default(autoincrement())
  name               String              @unique
  address            String?
  createdAt          DateTime            @default(now())
  code               String?             @unique
  academicSessions   AcademicSession[]
  academicTerms      AcademicTerm[]
  admissionSequences AdmissionSequence[]
  auditLogs          AuditLog[]
  bankQuestions      BankQuestion[]
  classes            Class[]
  students           Student[]
  subjects           Subject[]
  users              User[]

  @@map("school")
}

model AcademicSession {
  id        Int            @id @default(autoincrement())
  name      String
  isCurrent Boolean        @default(false)
  schoolId  Int
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  school    School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  terms     AcademicTerm[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

model AdmissionSequence {
  id            Int    @id @default(autoincrement())
  schoolId      Int
  admissionYear Int
  lastSerial    Int    @default(0)
  school        School @relation(fields: [schoolId], references: [id])

  @@unique([schoolId, admissionYear])
}

model AcademicTerm {
  id        Int             @id @default(autoincrement())
  name      String
  order     Int
  isCurrent Boolean         @default(false)
  sessionId Int
  schoolId  Int
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  school    School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  session   AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, name])
  @@unique([sessionId, order])
  @@index([schoolId])
}

model Class {
  id                 Int                 @id @default(autoincrement())
  name               String
  level              String
  createdAt          DateTime            @default(now())
  schoolId           Int
  updatedAt          DateTime            @updatedAt
  bankQuestions      BankQuestion[]
  school             School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  exams              Exam[]
  students           Student[]
  teacherAssignments TeacherAssignment[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

model Subject {
  id                 Int                 @id @default(autoincrement())
  name               String
  code               String
  createdAt          DateTime            @default(now())
  schoolId           Int
  updatedAt          DateTime            @updatedAt
  bankQuestions      BankQuestion[]
  exams              Exam[]
  school             School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacherAssignments TeacherAssignment[]

  @@unique([schoolId, name])
  @@unique([schoolId, code])
  @@index([schoolId])
}

model Student {
  id            Int             @id @default(autoincrement())
  firstName     String
  lastName      String
  gender        String?
  admissionNo   String?
  email         String?         @unique
  schoolId      Int
  classId       Int
  createdAt     DateTime        @default(now())
  userId        Int?            @unique
  admissionYear Int?
  examAttempts  ExamAttempt[]
  parents       ParentStudent[] @relation("StudentParents")
  class         Class           @relation(fields: [classId], references: [id])
  school        School          @relation(fields: [schoolId], references: [id])
  user          User?           @relation(fields: [userId], references: [id])

  @@unique([schoolId, admissionNo])
}

model Exam {
  id              Int           @id @default(autoincrement())
  title           String
  term            String
  session         String
  questionSource  String?
  durationMinutes Int
  startTime       DateTime?
  endTime         DateTime?
  totalMarks      Int
  status          ExamStatus    @default(DRAFT)
  subjectId       Int
  classId         Int
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @default(now()) @updatedAt
  class           Class         @relation(fields: [classId], references: [id])
  subject         Subject       @relation(fields: [subjectId], references: [id])
  attempts        ExamAttempt[]
  questions       Question[]
}

model Question {
  id                   Int             @id @default(autoincrement())
  questionText         String
  questionType         String
  marks                Int
  questionOrder        Int
  examId               Int
  sourceBankQuestionId Int?
  options              Option[]
  exam                 Exam            @relation(fields: [examId], references: [id])
  sourceBankQuestion   BankQuestion?   @relation(fields: [sourceBankQuestionId], references: [id])
  resultDetails        ResultDetail[]
  answers              StudentAnswer[]
}

model Option {
  id          Int             @id @default(autoincrement())
  optionText  String
  optionOrder Int
  isCorrect   Boolean
  questionId  Int
  question    Question        @relation(fields: [questionId], references: [id])
  answers     StudentAnswer[]
}

model ExamAttempt {
  id          Int             @id @default(autoincrement())
  startedAt   DateTime
  submittedAt DateTime?
  status      AttemptStatus   @default(IN_PROGRESS)
  studentId   Int
  examId      Int
  exam        Exam            @relation(fields: [examId], references: [id])
  student     Student         @relation(fields: [studentId], references: [id])
  result      Result?
  answers     StudentAnswer[]

  @@unique([studentId, examId])
}

model StudentAnswer {
  id               Int         @id @default(autoincrement())
  attemptId        Int
  questionId       Int
  selectedOptionId Int?
  answerText       String?
  answeredAt       DateTime
  attempt          ExamAttempt @relation(fields: [attemptId], references: [id])
  question         Question    @relation(fields: [questionId], references: [id])
  selectedOption   Option?     @relation(fields: [selectedOptionId], references: [id])

  @@unique([attemptId, questionId])
}

model Result {
  id          Int            @id @default(autoincrement())
  attemptId   Int            @unique
  score       Decimal
  percentage  Decimal
  grade       String
  generatedAt DateTime       @default(now())
  attempt     ExamAttempt    @relation(fields: [attemptId], references: [id])
  details     ResultDetail[]
}

model User {
  id                   Int                 @id @default(autoincrement())
  name                 String
  email                String?             @unique
  passwordHash         String
  role                 Role
  schoolId             Int?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  auditLogs            AuditLog[]          @relation("AuditLogActor")
  createdBankQuestions BankQuestion[]      @relation("BankQuestionCreator")
  parentChildren       ParentStudent[]     @relation("ParentChildren")
  student              Student?
  teacherAssignments   TeacherAssignment[]
  school               School?             @relation(fields: [schoolId], references: [id])
}

model ResultDetail {
  id           Int      @id @default(autoincrement())
  resultId     Int
  questionId   Int
  isCorrect    Boolean
  marksAwarded Decimal
  question     Question @relation(fields: [questionId], references: [id])
  result       Result   @relation(fields: [resultId], references: [id])

  @@unique([resultId, questionId])
}

model BankQuestion {
  id            Int          @id @default(autoincrement())
  questionText  String
  questionType  String       @default("OBJECTIVE")
  marks         Int
  isActive      Boolean      @default(true)
  schoolId      Int
  classId       Int
  subjectId     Int
  createdById   Int
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  options       BankOption[]
  class         Class        @relation(fields: [classId], references: [id])
  createdBy     User         @relation("BankQuestionCreator", fields: [createdById], references: [id])
  school        School       @relation(fields: [schoolId], references: [id])
  subject       Subject      @relation(fields: [subjectId], references: [id])
  examQuestions Question[]

  @@index([schoolId, classId, subjectId])
  @@index([createdById])
}

model BankOption {
  id             Int          @id @default(autoincrement())
  optionText     String
  optionOrder    Int
  isCorrect      Boolean      @default(false)
  bankQuestionId Int
  bankQuestion   BankQuestion @relation(fields: [bankQuestionId], references: [id], onDelete: Cascade)

  @@index([bankQuestionId])
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  userId      Int?
  schoolId    Int?
  actorName   String
  actorRole   String
  action      String
  entity      String
  entityId    String?
  description String
  metadata    Json?
  createdAt   DateTime @default(now())
  school      School?  @relation(fields: [schoolId], references: [id])
  user        User?    @relation("AuditLogActor", fields: [userId], references: [id])

  @@index([schoolId, createdAt])
  @@index([userId, createdAt])
  @@index([entity, entityId])
  @@index([action, createdAt])
}

enum ExamStatus {
  DRAFT
  PUBLISHED
  ACTIVE
  CLOSED
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  GRADED
}

enum Role {
  SUPER_ADMIN
  SCHOOL_ADMIN
  TEACHER
  STUDENT
  PARENT
}
