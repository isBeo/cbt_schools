generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model ParentStudent {
  id           Int     @id @default(autoincrement())
  parentId     Int
  studentId    Int
  relationship String?

  parent  User    @relation("ParentChildren", fields: [parentId], references: [id])
  student Student @relation("StudentParents", fields: [studentId], references: [id])

  createdAt DateTime @default(now())

  @@unique([parentId, studentId])
}

model TeacherAssignment {
  id        Int @id @default(autoincrement())
  teacherId Int
  classId   Int
  subjectId Int

  teacher User    @relation(fields: [teacherId], references: [id])
  class   Class   @relation(fields: [classId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])

  createdAt DateTime @default(now())

  @@unique([teacherId, classId, subjectId])
  @@index([teacherId])
  @@index([classId, subjectId])
}

model School {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  code      String?   @unique
  address   String?
  users     User[]
  createdAt DateTime  @default(now())
  students  Student[]

  bankQuestions BankQuestion[]
  auditLogs     AuditLog[]

  academicSessions   AcademicSession[]
  academicTerms      AcademicTerm[]
  classes            Class[]
  subjects           Subject[]
  admissionSequences AdmissionSequence[]

  @@map("school")
}

model AcademicSession {
  id        Int     @id @default(autoincrement())
  name      String
  isCurrent Boolean @default(false)
  schoolId  Int

  school School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  terms  AcademicTerm[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, name])
  @@index([schoolId])
}

model AdmissionSequence {
  id            Int @id @default(autoincrement())
  schoolId      Int
  admissionYear Int
  lastSerial    Int @default(0)

  school School @relation(fields: [schoolId], references: [id])

  @@unique([schoolId, admissionYear])
}

model AcademicTerm {
  id        Int     @id @default(autoincrement())
  name      String
  order     Int
  isCurrent Boolean @default(false)
  sessionId Int
  schoolId  Int

  session AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  school  School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sessionId, name])
  @@unique([sessionId, order])
  @@index([schoolId])
}

model Class {
  id       Int    @id @default(autoincrement())
  name     String
  level    String
  schoolId Int

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  exams              Exam[]
  students           Student[]
  bankQuestions      BankQuestion[]
  teacherAssignments TeacherAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, name])
  @@index([schoolId])
}

model Subject {
  id       Int    @id @default(autoincrement())
  name     String
  code     String
  schoolId Int

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  exams              Exam[]
  bankQuestions      BankQuestion[]
  teacherAssignments TeacherAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, name])
  @@unique([schoolId, code])
  @@index([schoolId])
}

model Student {
  id            Int     @id @default(autoincrement())
  firstName     String
  lastName      String
  gender        String?
  admissionNo   String?
  admissionYear Int?
  email         String? @unique

  schoolId Int
  classId  Int
  userId   Int? @unique

  createdAt DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id])
  class  Class  @relation(fields: [classId], references: [id])
  user   User?  @relation(fields: [userId], references: [id])

  parents      ParentStudent[] @relation("StudentParents")
  examAttempts ExamAttempt[]

  @@unique([schoolId, admissionNo])
}

model Exam {
  id Int @id @default(autoincrement())

  // Basic information
  title          String
  term           String
  session        String
  questionSource String?

  // Timing
  durationMinutes Int
  startTime       DateTime?
  endTime         DateTime?

  // Marking
  totalMarks Int

  // Exam state
  status ExamStatus @default(DRAFT)

  // Relationships
  subjectId Int
  classId   Int

  subject Subject @relation(fields: [subjectId], references: [id])
  class   Class   @relation(fields: [classId], references: [id])

  questions Question[]
  attempts  ExamAttempt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model Question {
  id            Int    @id @default(autoincrement())
  questionText  String
  questionType  String
  marks         Int
  questionOrder Int
  examId        Int

  options Option[]
  exam    Exam            @relation(fields: [examId], references: [id])
  answers StudentAnswer[]

  sourceBankQuestionId Int?
  sourceBankQuestion   BankQuestion? @relation(fields: [sourceBankQuestionId], references: [id], onDelete: SetNull)
}

enum ExamStatus {
  DRAFT
  PUBLISHED
  ACTIVE
  CLOSED
}

model Option {
  id          Int     @id @default(autoincrement())
  optionText  String
  optionOrder Int
  isCorrect   Boolean
  questionId  Int

  question Question        @relation(fields: [questionId], references: [id])
  answers  StudentAnswer[]
}

model ExamAttempt {
  id          Int       @id @default(autoincrement())
  startedAt   DateTime
  submittedAt DateTime?

  status AttemptStatus @default(IN_PROGRESS)

  studentId Int
  examId    Int

  exam    Exam    @relation(fields: [examId], references: [id])
  student Student @relation(fields: [studentId], references: [id])

  result  Result?
  answers StudentAnswer[]
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  GRADED
}

model StudentAnswer {
  id               Int      @id @default(autoincrement())
  attemptId        Int
  questionId       Int
  selectedOptionId Int?
  answerText       String?
  answeredAt       DateTime

  attempt        ExamAttempt @relation(fields: [attemptId], references: [id])
  question       Question    @relation(fields: [questionId], references: [id])
  selectedOption Option?     @relation(fields: [selectedOptionId], references: [id])
}

model Result {
  id          Int      @id @default(autoincrement())
  attemptId   Int      @unique
  score       Decimal
  percentage  Decimal
  grade       String
  generatedAt DateTime @default(now())

  attempt ExamAttempt    @relation(fields: [attemptId], references: [id])
  details ResultDetail[]
}

model User {
  id           Int     @id @default(autoincrement())
  name         String
  email        String? @unique
  passwordHash String

  role Role

  createdBankQuestions BankQuestion[] @relation("BankQuestionCreator")
  auditLogs            AuditLog[]     @relation("AuditLogActor")

  schoolId Int?
  school   School? @relation(fields: [schoolId], references: [id])

  student Student?

  parentChildren ParentStudent[] @relation("ParentChildren")

  teacherAssignments TeacherAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  SUPER_ADMIN
  SCHOOL_ADMIN
  TEACHER
  STUDENT
  PARENT
}

model ResultDetail {
  id           Int     @id @default(autoincrement())
  resultId     Int
  questionId   Int
  isCorrect    Boolean
  marksAwarded Decimal

  result Result @relation(fields: [resultId], references: [id])
}

model BankQuestion {
  id           Int     @id @default(autoincrement())
  questionText String
  questionType String  @default("OBJECTIVE")
  marks        Int
  isActive     Boolean @default(true)

  schoolId    Int
  classId     Int
  subjectId   Int
  createdById Int

  school    School  @relation(fields: [schoolId], references: [id])
  class     Class   @relation(fields: [classId], references: [id])
  subject   Subject @relation(fields: [subjectId], references: [id])
  createdBy User    @relation("BankQuestionCreator", fields: [createdById], references: [id])

  options       BankOption[]
  examQuestions Question[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId, classId, subjectId])
  @@index([createdById])
}

model BankOption {
  id             Int     @id @default(autoincrement())
  optionText     String
  optionOrder    Int
  isCorrect      Boolean @default(false)
  bankQuestionId Int

  bankQuestion BankQuestion @relation(fields: [bankQuestionId], references: [id], onDelete: Cascade)

  @@index([bankQuestionId])
}

model AuditLog {
  id       Int  @id @default(autoincrement())
  userId   Int?
  schoolId Int?

  // Historical identity of the person who performed the action
  actorName String
  actorRole String

  action      String
  entity      String
  entityId    String?
  description String
  metadata    Json?

  user   User?   @relation("AuditLogActor", fields: [userId], references: [id], onDelete: SetNull)
  school School? @relation(fields: [schoolId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([schoolId, createdAt])
  @@index([userId, createdAt])
  @@index([entity, entityId])
  @@index([action, createdAt])
}
