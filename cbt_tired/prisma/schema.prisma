// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model ParentStudent {
  id           Int     @id @default(autoincrement())
  parentId     Int
  studentId    Int
  relationship String?

  parent  User    @relation("ParentChildren", fields: [parentId], references: [id])
  student Student @relation("StudentParents", fields: [studentId], references: [id])

  createdAt DateTime @default(now())

  @@unique([parentId, studentId])
}

model TeacherAssignment {
  id        Int @id @default(autoincrement())
  teacherId Int
  classId   Int
  subjectId Int

  teacher User    @relation(fields: [teacherId], references: [id])
  class   Class   @relation(fields: [classId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])

  createdAt DateTime @default(now())

  @@unique([teacherId, classId, subjectId])
}

model School {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  address   String?
  users     User[]
  createdAt DateTime  @default(now())
  students  Student[]

  @@map("school")
}

model Class {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  level    String
  exams    Exam[]
  students Student[]

  teacherAssignments TeacherAssignment[]
}

model Subject {
  id    Int    @id @default(autoincrement())
  name  String @unique
  code  String @unique
  exams Exam[]

  teacherAssignments TeacherAssignment[]
}

model Student {
  id          Int     @id @default(autoincrement())
  firstName   String
  lastName    String
  gender      String?
  admissionNo String? @unique
  email       String? @unique

  schoolId Int
  classId  Int
  userId   Int? @unique

  createdAt DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id])
  class  Class  @relation(fields: [classId], references: [id])
  user   User?  @relation(fields: [userId], references: [id])

  parents ParentStudent[] @relation("StudentParents")

  examAttempts ExamAttempt[]
}

model Exam {
  id Int @id @default(autoincrement())

  // Basic information
  title          String
  term           String
  session        String
  questionSource String?

  // Timing
  durationMinutes Int
  startTime       DateTime?
  endTime         DateTime?

  // Marking
  totalMarks Int

  // Exam state
  status ExamStatus @default(DRAFT)

  // Relationships
  subjectId Int
  classId   Int

  subject Subject @relation(fields: [subjectId], references: [id])
  class   Class   @relation(fields: [classId], references: [id])

  questions Question[]
  attempts  ExamAttempt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model Question {
  id            Int             @id @default(autoincrement())
  questionText  String
  questionType  String
  marks         Int
  questionOrder Int
  examId        Int
  options       Option[]
  exam          Exam            @relation(fields: [examId], references: [id])
  answers       StudentAnswer[]
}

enum ExamStatus {
  DRAFT
  PUBLISHED
  ACTIVE
  CLOSED
}

model Option {
  id          Int             @id @default(autoincrement())
  optionText  String
  optionOrder Int
  isCorrect   Boolean
  questionId  Int
  question    Question        @relation(fields: [questionId], references: [id])
  answers     StudentAnswer[]
}

model ExamAttempt {
  id          Int       @id @default(autoincrement())
  startedAt   DateTime
  submittedAt DateTime?

  status AttemptStatus @default(IN_PROGRESS)

  studentId Int
  examId    Int

  exam    Exam    @relation(fields: [examId], references: [id])
  student Student @relation(fields: [studentId], references: [id])

  result  Result?
  answers StudentAnswer[]
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  GRADED
}

model StudentAnswer {
  id               Int         @id @default(autoincrement())
  attemptId        Int
  questionId       Int
  selectedOptionId Int?
  answerText       String?
  answeredAt       DateTime
  attempt          ExamAttempt @relation(fields: [attemptId], references: [id])
  question         Question    @relation(fields: [questionId], references: [id])
  selectedOption   Option?     @relation(fields: [selectedOptionId], references: [id])
}

model Result {
  id          Int            @id @default(autoincrement())
  attemptId   Int            @unique
  score       Decimal
  percentage  Decimal
  grade       String
  generatedAt DateTime       @default(now())
  attempt     ExamAttempt    @relation(fields: [attemptId], references: [id])
  details     ResultDetail[]
}

model User {
  id           Int    @id @default(autoincrement())
  name         String
  email        String @unique
  passwordHash String

  role Role

  schoolId Int?
  school   School? @relation(fields: [schoolId], references: [id])

  student Student?

  parentChildren ParentStudent[] @relation("ParentChildren")

  teacherAssignments TeacherAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  SUPER_ADMIN
  SCHOOL_ADMIN
  TEACHER
  STUDENT
  PARENT
}

model ResultDetail {
  id           Int     @id @default(autoincrement())
  resultId     Int
  questionId   Int
  isCorrect    Boolean
  marksAwarded Decimal
  result       Result  @relation(fields: [resultId], references: [id])
}
